# ~/.gitconfig   (stow package: git)
[user]
	name = Sanket Nayak
	email = sanket1598@ugmail.com
	signingKey = 52F6F799A9080F21

[init]
	defaultBranch = main

[color]
	ui = auto

# ----- delta: a much nicer diff pager (Catppuccin Mocha) -------------------
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	features = catppuccin-mocha
	navigate = true        # n / N to jump between files in the diff
	line-numbers = true
	side-by-side = false   # set true if you like split view
	hyperlinks = true
[merge]
	conflictstyle = zdiff3 # clearer 3-way conflict markers
[diff]
	colorMoved = default

# ----- sensible modern defaults --------------------------------------------
[push]
	default = simple
	autoSetupRemote = true # `git push` on a new branch just works
[pull]
	rebase = true
[fetch]
	prune = true
[rebase]
	autoStash = true
[commit]
	gpgSign = false
[gpg]
	program = gpg

# ----- aliases (yours + a couple of additions) -----------------------------
[alias]
	s = status
	d = diff
	co = checkout
	br = branch
	cm = commit -m
	graph = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(bold blue)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	logdoga = log --decorate --oneline --graph --all
	last = log -1 HEAD --stat
	unstage = restore --staged

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
